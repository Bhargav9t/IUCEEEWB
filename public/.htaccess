DirectoryIndex index.html index.htm

# Fallback error handlers - routes 403/404 directly to the SPA instead of server error page
ErrorDocument 403 /index.html
ErrorDocument 404 /index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force root / to serve index.html directly (bypass any server index.php)
  RewriteRule ^$ index.html [L]

  # 2. Redirect any legacy /index.php requests to /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.php [NC]
  RewriteRule ^index\.php$ / [R=301,L]

  # 3. Strip .html or .php extensions from legacy URLs
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.]+)\.(html|php) [NC]
  RewriteRule ^ %1/ [R=301,L]

  # 4. Redirect legacy Google Search URLs to new routes
  RewriteRule ^about-us/?$ /about/ [R=301,L,NC]
  RewriteRule ^core-team.*$ /team/ [R=301,L,NC]
  RewriteRule ^team-2024.*$ /team/ [R=301,L,NC]
  RewriteRule ^contact.*$ /about/ [R=301,L,NC]
  RewriteRule ^innofiesta.*$ /events/ [R=301,L,NC]

  # 5. Direct request to index.html
  RewriteRule ^index\.html$ - [L]

  # 6. If directory is accessed without trailing slash, redirect with trailing slash
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # 7. If direct file exists, serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 8. If directory has index.html, serve it directly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 9. SPA Fallback: rewrite any other non-existent files/directories to root index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
